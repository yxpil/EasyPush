{
  "name": "easypush",
  "version": "1.0.0",
  "private": true,
  "description": "LAN presentation hub: cast photos, videos and screens to your desktop.",
  "author": "yxpil",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prebuild": "node scripts/make-icons.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build --config vite.renderer.config.mts",
    "build:web": "vite build --config vite.web.config.mts",
    "build": "npm run clean && npm run build:main && npm run build:renderer && npm run build:web",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "oxlint src web tests",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "verify:package": "node scripts/verify-package.mjs",
    "icon": "node scripts/make-icons.mjs",
    "dist:dir": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "hls.js": "1.7.3",
    "node-forge": "1.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/node-forge": "1.3.11",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "oxlint": "1.89.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
